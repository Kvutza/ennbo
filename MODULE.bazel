module(name = "ennbo", version = "0.3.14")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "openmp", version = "21.1.5.bcr.2")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_rust", version = "0.71.3")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)
http_archive(
    name = "faiss_src",
    build_file = "//bazel/faiss:BUILD.faiss.bazel",
    sha256 = "561376d1a44771bf1230fabeef9c81643468009b45a585382cf38d3a7a94990a",
    strip_prefix = "faiss-1.12.0",
    urls = ["https://github.com/facebookresearch/faiss/archive/refs/tags/v1.12.0.tar.gz"],
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.88.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//rust:Cargo.lock",
    manifests = ["//rust:Cargo.toml"],
    supported_platform_triples = ["aarch64-apple-darwin"],
)
crate.spec(
    package = "metal",
    repositories = ["accelerator_crates"],
    version = "0.33.0",
)
crate.spec(
    package = "opencl3",
    repositories = ["accelerator_crates"],
    version = "0.12.3",
)
crate.from_specs(
    name = "accelerator_crates",
    supported_platform_triples = ["aarch64-apple-darwin"],
)
use_repo(crate, "accelerator_crates", "crates")
