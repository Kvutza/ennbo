load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# FAISS 1.12.0 is pinned to match faiss-sys 0.7.0.  Build the native library
# directly with Bazel so Rust never invokes faiss-sys's host-discovering CMake
# build script.

OMP_COPTS = select({
    "@platforms//os:linux": ["-fopenmp"],
    "@platforms//os:macos": [
        "-Xclang",
        "-fopenmp",
    ],
    "@platforms//os:windows": ["/openmp"],
    "//conditions:default": [],
})

OMP_DEPS = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["@openmp//:openmp"],
})

CXX_COPTS = select({
    "@platforms//os:windows": ["/std:c++17"],
    "//conditions:default": [
        "-std=c++17",
        "-Wno-deprecated-declarations",
        "-Wno-unknown-pragmas",
    ],
})

cc_library(
    name = "blas",
    deps = select({
        "@platforms//os:linux": ["@ennx//bazel/openblas"],
        "@platforms//os:macos": [":sdk_blas"],
        "@platforms//os:windows": ["@ennx//bazel/openblas"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "sdk_blas",
    linkopts = select({
        "@platforms//os:macos": [
            "-framework",
            "Accelerate",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

FAISS_HEADERS = glob(
    ["faiss/**/*.h"],
    exclude = [
        "faiss/gpu/**",
        "faiss/python/**",
    ],
)

FAISS_SRCS = glob(
    ["faiss/**/*.cpp"],
    exclude = [
        "faiss/cppcontrib/**",
        "faiss/gpu/**",
        "faiss/invlists/OnDiskInvertedLists.cpp",
        "faiss/python/**",
    ],
) + select({
    "@platforms//os:windows": [],
    "//conditions:default": ["faiss/invlists/OnDiskInvertedLists.cpp"],
})

cc_library(
    name = "faiss",
    srcs = FAISS_SRCS,
    hdrs = FAISS_HEADERS,
    copts = CXX_COPTS + OMP_COPTS,
    defines = ["FINTEGER=int"],
    includes = ["."],
    deps = [
        ":blas",
    ] + OMP_DEPS,
)

cc_library(
    name = "faiss_c",
    srcs = glob(
        ["c_api/**/*.cpp"],
        exclude = ["c_api/gpu/**"],
    ),
    hdrs = glob(
        ["c_api/**/*.h"],
        exclude = ["c_api/gpu/**"],
    ),
    copts = CXX_COPTS + OMP_COPTS,
    includes = ["."],
    deps = [":faiss"] + OMP_DEPS,
)
