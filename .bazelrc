common --enable_bzlmod

test --test_output=errors

# Optional laptop-friendly limits. Public builds and downstream consumers do
# not inherit machine-specific paths or resource caps.
build:constrained --jobs=3
build:constrained --local_resources=cpu=4
build:constrained --local_resources=memory=6144
test:constrained --test_arg=--test-threads=1

# Stable platform entry points. Native dependencies use Bazel platform
# constraints; these defines keep the user-facing configs explicit.
build:macos --define=ennbo_platform=macos
build:linux --define=ennbo_platform=linux
build:windows --define=ennbo_platform=windows

# Match the optimized Cargo/maturin build used by the original checkout.
build:release --compilation_mode=opt
