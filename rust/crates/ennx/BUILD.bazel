load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

ENNX_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/ennx_build.rs"],
)

ENNX_DEPS = all_crate_deps(normal = True) + [
    "//rust/crates/bpann",
]

cc_library(
    name = "faiss_bridge",
    srcs = ["src/faiss_bridge.cpp"],
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    deps = ["@faiss_src//:faiss"],
)

rust_library(
    name = "ennx_cpu",
    srcs = ENNX_SRCS,
    aliases = aliases(),
    crate_name = "ennx",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [":faiss_bridge"],
    deps = ENNX_DEPS,
)

rust_library(
    name = "ennx_metal",
    srcs = ENNX_SRCS,
    aliases = aliases(),
    compile_data = glob(["src/**/*.metal"]),
    crate_features = ["metal"],
    crate_name = "ennx",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [":faiss_bridge"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = ENNX_DEPS + [
        "@accelerator_crates//:metal",
    ],
)

rust_library(
    name = "ennx_opencl",
    srcs = ENNX_SRCS,
    aliases = aliases(),
    compile_data = glob(["src/**/*.cl"]),
    crate_features = ["opencl"],
    crate_name = "ennx",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [":faiss_bridge"],
    deps = ENNX_DEPS + [
        "@accelerator_crates//:opencl3",
    ],
)

alias(
    name = "ennx",
    actual = ":ennx_cpu",
)

alias(
    name = "ennx_accelerators",
    actual = select({
        "@platforms//os:linux": ":ennx_opencl",
        "@platforms//os:macos": ":ennx_metal",
        "@platforms//os:windows": ":ennx_opencl",
        "//conditions:default": ":ennx_cpu",
    }),
)

rust_test(
    name = "ennx_test",
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate = ":ennx_cpu",
    deps = all_crate_deps(
        normal_dev = True,
        proc_macro_dev = True,
    ),
)

rust_binary(
    name = "trial_bench_metal",
    srcs = ["examples/trial_bench.rs"],
    aliases = aliases(normal_dev = True),
    crate_name = "trial_bench_metal",
    crate_root = "examples/trial_bench.rs",
    edition = crate_edition(),
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        ":ennx_metal",
    ],
)

rust_binary(
    name = "trial_bench_opencl",
    srcs = ["examples/trial_bench.rs"],
    aliases = aliases(normal_dev = True),
    crate_name = "trial_bench_opencl",
    crate_root = "examples/trial_bench.rs",
    edition = crate_edition(),
    deps = [
        ":ennx_opencl",
    ],
)

rust_test(
    name = "trial_search_metal_test",
    srcs = ["tests/trial_search.rs"],
    aliases = aliases(
        normal_dev = True,
        proc_macro_dev = True,
    ),
    crate_features = ["metal"],
    crate_name = "trial_search_metal_test",
    crate_root = "tests/trial_search.rs",
    edition = crate_edition(),
    target_compatible_with = ["@platforms//os:macos"],
    deps = all_crate_deps(
        normal_dev = True,
        proc_macro_dev = True,
    ) + [
        ":ennx_metal",
        "@crates//:ndarray",
    ],
)

rust_test(
    name = "trial_search_opencl_test",
    srcs = ["tests/trial_search.rs"],
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    crate_features = ["opencl"],
    crate_name = "trial_search_opencl_test",
    crate_root = "tests/trial_search.rs",
    edition = crate_edition(),
    deps = all_crate_deps(normal_dev = True, proc_macro_dev = True) + [
        ":ennx_opencl",
        "@crates//:ndarray",
    ],
)
