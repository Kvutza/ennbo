load("@crates//:defs.bzl", "aliases", "all_crate_deps", "crate_edition")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

cc_library(
    name = "faiss_bridge",
    srcs = ["src/faiss_bridge.cpp"],
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    deps = ["@faiss_src//:faiss"],
)

rust_library(
    name = "ennbo",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/ennbo_build.rs"],
    ),
    aliases = aliases(),
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [":faiss_bridge"],
    deps = all_crate_deps(normal = True) + [
        "//rust/crates/bpann",
    ],
)

rust_library(
    name = "ennbo_accelerators",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/ennbo_build.rs"],
    ),
    aliases = aliases(),
    compile_data = glob([
        "src/**/*.cl",
        "src/**/*.metal",
    ]),
    crate_features = [
        "metal",
        "opencl",
    ],
    crate_name = "ennbo",
    crate_root = "src/lib.rs",
    edition = crate_edition(),
    link_deps = [":faiss_bridge"],
    deps = all_crate_deps(normal = True) + [
        "//rust/crates/bpann",
        "@accelerator_crates//:metal",
        "@accelerator_crates//:opencl3",
    ],
)

rust_test(
    name = "ennbo_test",
    crate = ":ennbo",
    aliases = aliases(normal_dev = True, proc_macro_dev = True),
    deps = all_crate_deps(normal_dev = True, proc_macro_dev = True),
)
